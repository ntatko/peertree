{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PeerTree",
  "version": "0.5.1",
  "identifier": "io.github.ntatko.peertree",
  "build": {
    "frontendDist": "frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'",
      "capabilities": ["launcher"]
    }
  },
  "bundle": {
    "active": false,
    "icon": ["frontend/peertree-icon.png"],
    "macOS": {
      "minimumSystemVersion": "15.0"
    }
  }
}
